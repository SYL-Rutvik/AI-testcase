# Google Gemini AI API Key (Get free key at: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Express Server Port
PORT=5000

# Cloud MongoDB Atlas Connection URI (100% Free Forever M0 Cluster)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxx.mongodb.net/ai-testcase?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_super_secret_key_here

# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
